==> crates/modules/demo_notes/src/lib.rs <==
//! `campbooks-demo-notes` — the `demo_notes` module.
//!
//! TODO(new-module): say in one paragraph what this module owns, using the
//! language of its entry in `docs/domain-map.md`.
//!
//! Generated by `cargo xtask new-module`; the shape is the one of the
//! reference module, `campbooks-system`. `lib.rs` only assembles [`module`];
//! each use case is a folder under `features/` (add one with
//! `cargo xtask new-feature demo_notes <feature>`).

#![forbid(unsafe_code)]

use campbooks_kernel::{
    AppState, Background, Module,
    authz::{Action, Owner, ResourceType, Resources, Tenancy},
};
use utoipa_axum::{router::OpenApiRouter, routes};

pub mod events;
mod features;
pub mod scopes;

/// Module name: crate directory, Postgres schema and OpenAPI tag.
pub const NAME: &str = "demo_notes";

/// The record type of a person's own view of the module.
pub const ACCOUNT_RECORD: &str = "demo_notes.account";

/// The module's part of the access catalogue (ADR 0017).
// TODO(new-module): declare each resource type the module serves: its
// tenancy, its owner, the owner's actions and who else may do what (a
// workspace role, a container role, client tokens). Workspace types need a
// `ResourceFacts` port: `Resources::new(&RESOURCES, Arc::new(…))`, as in
// `campbooks-conversations`.
static RESOURCES: [ResourceType; 1] = [ResourceType {
    owner: Owner::Account,
    owner_actions: &[Action::Read],
    ..ResourceType::new(
        ACCOUNT_RECORD,
        "What a signed-in person reads of this module.",
        Tenancy::Account,
    )
}];

/// The `demo_notes` module, ready for the server to mount.
pub fn module() -> Module {
    Module {
        name: NAME,
        scopes: scopes::ALL,
        router: router(),
        admin_router: None,
        background: Background::new(),
        resources: Resources::declared(&RESOURCES),
    }
}

/// Every route of the module, one per feature.
fn router() -> OpenApiRouter<AppState> {
    OpenApiRouter::new().routes(routes!(features::overview::handler))
}

#[cfg(test)]
mod tests {
    use sqlx::PgPool;

    #[test]
    fn module_is_named_after_its_schema() {
        assert_eq!(super::module().name, "demo_notes");
    }

    // A runtime query rather than `query!`, so this generated test needs no
    // entry in the `.sqlx` offline cache.
    #[sqlx::test(migrations = "../../../migrations")]
    async fn migrations_create_the_demo_notes_schema(db: PgPool) {
        let exists: bool =
            sqlx::query_scalar("SELECT EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = $1)")
                .bind(super::NAME)
                .fetch_one(&db)
                .await
                .unwrap();
        assert!(exists);
    }
}

==> crates/modules/demo_notes/src/scopes.rs <==
//! The OAuth scopes of the `demo_notes` module (see `campbooks_kernel::auth`).
//!
//! A scope name is a wire contract with the identity provider and every
//! client: never rename one. Add a scope here and to [`ALL`] before an
//! endpoint requires it.

use campbooks_kernel::auth::{ScopeInfo, ScopeName};

/// Every scope of this module, for its `Module` descriptor.
pub const ALL: &[ScopeInfo] = &[
    ScopeInfo::of::<DemoNotesRead>(),
    ScopeInfo::of::<DemoNotesWrite>(),
];

/// `demo_notes:read` — read this module's data.
#[derive(Debug, Clone, Copy)]
pub struct DemoNotesRead;

impl ScopeName for DemoNotesRead {
    const NAME: &'static str = "demo_notes:read";
    const DESCRIPTION: &'static str = "Read your demo notes data.";
}

/// `demo_notes:write` — change this module's data.
#[derive(Debug, Clone, Copy)]
pub struct DemoNotesWrite;

impl ScopeName for DemoNotesWrite {
    const NAME: &'static str = "demo_notes:write";
    const DESCRIPTION: &'static str = "Change your demo notes data.";
}

==> crates/modules/demo_notes/src/events.rs <==
//! The domain events the `demo_notes` module publishes (ADR 0012). None yet.
//!
//! Declare each one here as a `campbooks_kernel::DomainEvent` named
//! `demo_notes.<event>` with an explicit `VERSION`, publish it in the
//! transaction that makes the change (`state.events.publish(&mut tx, &event)`),
//! and describe it in the module's spec. Derive `utoipa::ToSchema` too and
//! declare it in the module's background (`Background::new().publishes::<E>()`)
//! so it is listed in `openapi/events.json` (`cargo xtask events`; ADR 0013).
//! Other modules subscribe to these types; they never call this module
//! directly.

