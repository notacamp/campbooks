// Public surface of the `demo_notes` module (mirrors crates/modules/demo_notes).
// Other modules and the app shell import from here only.
export { buildDemoNotesRoutes } from "./routes";

==> clients/app/src/modules/demo-notes/routes.tsx <==
import { createRoute, type AnyRoute } from "@tanstack/react-router";

import { DemoNotesHome } from "./components/DemoNotesHome/DemoNotesHome";

/** The module's pages; in the app, `parent` is the workspace layout (`/w/$workspaceId`). */
export function buildDemoNotesRoutes<TParent extends AnyRoute>(parent: TParent) {
  const home = createRoute({
    getParentRoute: () => parent,
    path: "/demo-notes",
    component: DemoNotesHome,
  });
  return [home] as const;
}

==> clients/app/src/modules/demo-notes/routes.test.tsx <==
import {
  createMemoryHistory,
  createRootRoute,
  createRouter,
  Outlet,
  RouterProvider,
} from "@tanstack/react-router";
import { screen } from "@testing-library/react";
import { describe, expect, it } from "vitest";

import { renderWithProviders } from "../../../test/render";

import { buildDemoNotesRoutes } from "./index";

function renderAt(path: string, locale: "en" | "pt-PT" = "en") {
  const root = createRootRoute({ component: Outlet });
  const router = createRouter({
    routeTree: root.addChildren(buildDemoNotesRoutes(root)),
    history: createMemoryHistory({ initialEntries: [path] }),
  });
  renderWithProviders(<RouterProvider router={router} />, locale);
}

describe("buildDemoNotesRoutes", () => {
  it("mounts the demo_notes home page", async () => {
    renderAt("/demo-notes");

    expect(await screen.findByRole("heading", { name: "Demo notes" })).toBeVisible();
  });

  it("renders in the user's language", async () => {
    renderAt("/demo-notes", "pt-PT");

    expect(await screen.findByText("Este módulo ainda não tem ecrãs.")).toBeVisible();
  });
});

