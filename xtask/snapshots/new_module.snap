import { Heading, Text } from "~/lib/ui";

/** Placeholder home page of the `demo_notes` module. */
export function DemoNotesHome() {
  const { t } = useTranslation("demo-notes");

  return (
    <section aria-labelledby="demo-notes-home-title" className="flex max-w-measure flex-col gap-4 p-6">
      <Heading level={1} size="page" id="demo-notes-home-title">
        {t("title")}
