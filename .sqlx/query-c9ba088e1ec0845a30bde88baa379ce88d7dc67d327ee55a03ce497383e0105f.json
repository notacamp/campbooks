{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, token_hash = $1 AS \"current!\", rotated_at, subject, name, email,\n               access_token, access_expires_at, last_seen_at, expires_at\n          FROM bff.sessions\n         WHERE (token_hash = $1 OR (previous_token_hash = $1 AND rotated_at > $3))\n           AND idle_expires_at > $2\n           AND expires_at > $2\n        ",
