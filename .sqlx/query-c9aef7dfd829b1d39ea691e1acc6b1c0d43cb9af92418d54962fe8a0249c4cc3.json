{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT w.id AS \"id: WorkspaceId\", w.name, m.role\n                  FROM workspaces.members m\n                  JOIN workspaces.workspaces w ON w.id = m.workspace_id\n                 WHERE m.user_id = $1 AND w.deleted_at IS NULL\n                 ORDER BY w.created_at, w.id\n                ",
