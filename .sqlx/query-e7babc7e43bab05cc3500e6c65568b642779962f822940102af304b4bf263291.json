  "query": "\n        SELECT id AS \"id: MessageId\", direction, sender, recipients, subject, sent_at, read,\n               starred, bodies\n          FROM conversations.messages\n         WHERE conversation_id = $1\n         ORDER BY sent_at DESC, id DESC\n         LIMIT $2\n        ",
