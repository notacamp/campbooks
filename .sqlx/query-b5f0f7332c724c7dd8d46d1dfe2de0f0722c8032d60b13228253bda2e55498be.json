  "query": "\n        SELECT w.id AS \"id: WorkspaceId\", w.name, w.kind, m.role, m.joined_at, w.deleted_at\n          FROM workspaces.members m\n          JOIN workspaces.workspaces w ON w.id = m.workspace_id\n         WHERE m.user_id = $1\n         ORDER BY m.joined_at, w.id\n        ",
