  "db_name": "PostgreSQL",
  "query": "\n        SELECT stream, count(*)::int AS \"conversations!\",\n               count(*) FILTER (WHERE unread_count > 0)::int AS \"unread!\"\n          FROM conversations.conversations\n         WHERE inbox_id = ANY($1) AND archived_at IS NULL AND NOT trashed\n         GROUP BY stream\n        ",
