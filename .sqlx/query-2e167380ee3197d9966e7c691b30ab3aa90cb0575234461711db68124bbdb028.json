  "query": "\n        SELECT action, principal, workspace_id, payload,\n               expires_at <= now() AS \"expired!\",\n               redeemed_at IS NOT NULL AS \"redeemed!\"\n          FROM kernel.undo_tokens\n         WHERE token_hash = sha256(convert_to($1, 'UTF8'))\n           FOR UPDATE\n        ",
