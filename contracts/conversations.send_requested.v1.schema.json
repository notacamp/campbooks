{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campbooks.example.com/contracts/conversations.send_requested.v1.schema.json",
  "title": "conversations.send_requested v1 (event payload)",
  "description": "Published by the conversations module when a member's send leaves its undo window: the connectors module's outbound work. Ids and a blob reference only; the message is an outgoing-message v1 blob. Workspace-scoped.",
  "type": "object",
  "required": [
    "workspace",
    "inbox_id",
    "send_id",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "workspace": {
      "type": "string"
    },
    "inbox_id": {
      "$ref": "#/$defs/uuid"
    },
    "send_id": {
      "$ref": "#/$defs/uuid",
      "description": "Unique per send; the connector records each once."
    },
    "message": {
      "$ref": "#/$defs/blob",
      "description": "The outgoing-message v1 document, a blob of the workspace."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "blob": {
      "type": "object",
      "required": [
        "hash",
        "size",
        "content_type"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        }
      }
    }
  }
}
