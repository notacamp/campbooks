{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campbooks.example.com/contracts/pages.notion_changes_requested.v1.schema.json",
  "title": "pages.notion_changes_requested v1 (event payload)",
  "description": "Published by the pages module when a member's edits to a page kept in step with Notion ask for block changes to be made there. Ids and a blob reference only: the event is not proof (any transaction in a workspace can append that workspace's events), so the connectors module asks this module through the kernel's page-requests port whether the request still stands and records what the port returns, not what the event names. Workspace-scoped; also listed in openapi/events.json.",
  "type": "object",
  "required": [
    "workspace",
    "request",
    "page",
    "connection",
    "notion_page",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "workspace": {
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/uuid"
    },
    "page": {
      "$ref": "#/$defs/uuid"
    },
    "connection": {
      "$ref": "#/$defs/uuid"
    },
    "notion_page": {
      "$ref": "#/$defs/uuid"
    },
    "body": {
      "$ref": "#/$defs/blob",
      "description": "A `notion-block-changes` v1 document."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "blob": {
      "type": "object",
      "required": [
        "hash",
        "size",
        "content_type"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        }
      }
    }
  }
}
