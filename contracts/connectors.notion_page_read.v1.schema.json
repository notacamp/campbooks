{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campbooks.example.com/contracts/connectors.notion_page_read.v1.schema.json",
  "title": "connectors.notion_page_read v1 (event payload)",
  "description": "Published by the connectors module when it has read a linked Notion page's blocks: the pages module applies the snapshot to the page linked to it. Ids, a blob reference and a time; never any text. `read_at` grows with every read of one Notion page: apply only newer ones. Workspace-scoped; also listed in openapi/events.json.",
  "type": "object",
  "required": [
    "workspace",
    "connection",
    "notion_page",
    "page",
    "snapshot",
    "read_at"
  ],
  "additionalProperties": false,
  "properties": {
    "workspace": {
      "type": "string"
    },
    "connection": {
      "$ref": "#/$defs/uuid"
    },
    "notion_page": {
      "$ref": "#/$defs/uuid"
    },
    "page": {
      "$ref": "#/$defs/uuid"
    },
    "snapshot": {
      "$ref": "#/$defs/blob",
      "description": "A `notion-page-snapshot` v1 document."
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "blob": {
      "type": "object",
      "required": [
        "hash",
        "size",
        "content_type"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        }
      }
    }
  }
}
