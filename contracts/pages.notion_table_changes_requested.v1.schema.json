{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campbooks.example.com/contracts/pages.notion_table_changes_requested.v1.schema.json",
  "title": "pages.notion_table_changes_requested v1 (event payload)",
  "description": "Published by the pages module when a member's edits of a table kept in step with a Notion database ask for changes there: columns added, changed or removed (a removal only with the member's confirmation), rows added or trashed, cells set. Ids and a blob reference only: what to write is in the blob, which the pages module stored and the connectors module reads through the kernel's page-requests port, never from the event. Workspace-scoped; also listed in openapi/events.json.",
  "type": "object",
  "required": [
    "workspace",
    "request",
    "table",
    "connection",
    "data_source",
    "body"
  ],
  "additionalProperties": false,
  "properties": {
    "workspace": {
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/uuid"
    },
    "table": {
      "$ref": "#/$defs/uuid"
    },
    "connection": {
      "$ref": "#/$defs/uuid"
    },
    "data_source": {
      "$ref": "#/$defs/uuid"
    },
    "body": {
      "$ref": "#/$defs/blob",
      "description": "A `notion-table-changes` v1 document."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "blob": {
      "type": "object",
      "required": [
        "hash",
        "size",
        "content_type"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "content_type": {
          "type": "string"
        }
      }
    }
  }
}
