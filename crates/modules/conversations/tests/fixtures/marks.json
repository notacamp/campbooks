 {
  "name": "link with words",
  "doc": {
   "type": "doc",
   "content": [
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "See "
      },
      {
       "type": "text",
       "text": "the lease",
       "marks": [
        {
         "type": "link",
         "attrs": {
          "href": "https://example.com/4b"
         }
        }
       ]
      },
      {
       "type": "text",
       "text": "."
      }
     ]
    }
   ]
  },
  "marks": "See [the lease](https://example.com/4b).",
  "html": "<div><p>See <a href=\"https://example.com/4b\">the lease</a>.</p></div>",
  "plain": "See the lease <https://example.com/4b>."
 },
 {
