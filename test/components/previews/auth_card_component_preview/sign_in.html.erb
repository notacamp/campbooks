<div class="auth-canvas relative flex min-h-[680px] w-full flex-col items-center justify-center overflow-hidden px-4 py-10">
  <%= render(Campbooks::AuthCard.new(title: "Welcome back", subtitle: "Your inbox has been sorting itself. Sign in to catch up.")) do %>
    <div class="mt-9 space-y-5">
      <%= render(Campbooks::Input.new("email_address", type: :email, label: "Email", placeholder: "you@work.com")) %>
      <%= render(Campbooks::Input.new("password", type: :password, label: "Password", placeholder: "••••••••")) %>
      <div class="pt-1">
        <%= render(Campbooks::Button.new(variant: :primary, size: :lg, class: "w-full justify-center")) { "Sign in" } %>
      </div>
      <p class="text-center text-sm">
        <a href="#" class="font-medium text-muted-foreground hover:text-foreground">Forgot your password?</a>
      </p>
    </div>

    <div>
      <%= render(Campbooks::Divider.new(label: "or", surface: :card, class: "my-6")) %>
      <div class="space-y-2.5">
        <%= render(Campbooks::OauthButton.new(provider: :google, href: "#", size: :lg)) %>
        <%= render(Campbooks::OauthButton.new(provider: :zoho, href: "#", size: :lg)) %>
      </div>
      <p class="mt-7 text-center text-sm text-muted-foreground">
        No account yet?
        <a href="#" class="font-medium text-foreground hover:text-accent-700">Sign up</a>
      </p>
    </div>
  <% end %>
</div>
