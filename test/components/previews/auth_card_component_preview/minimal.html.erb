<div class="auth-canvas relative flex min-h-[520px] w-full flex-col items-center justify-center overflow-hidden px-4 py-10">
  <%= render(Campbooks::AuthCard.new(title: "Reset your password", subtitle: "Enter your email and we'll send you a reset link.")) do %>
    <div class="mt-9 space-y-5">
      <%= render(Campbooks::Input.new("email_address", type: :email, label: "Email", placeholder: "you@work.com")) %>
      <div class="pt-1">
        <%= render(Campbooks::Button.new(variant: :primary, size: :lg, class: "w-full justify-center")) { "Send reset link" } %>
      </div>
    </div>
  <% end %>
</div>
