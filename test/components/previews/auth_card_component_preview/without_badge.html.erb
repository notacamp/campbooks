<div class="auth-canvas relative flex min-h-[520px] w-full flex-col items-center justify-center overflow-hidden px-4 py-10">
  <%= render(Campbooks::AuthCard.new(title: "Create your account", subtitle: "Self-hosted builds drop the Beta badge.", badge: false)) do %>
    <div class="mt-9 space-y-5">
      <%= render(Campbooks::Input.new("name", type: :text, label: "Name", placeholder: "Ada Lovelace")) %>
      <%= render(Campbooks::Input.new("email_address", type: :email, label: "Email", placeholder: "you@work.com")) %>
      <div class="pt-1">
        <%= render(Campbooks::Button.new(variant: :primary, size: :lg, class: "w-full justify-center")) { "Continue" } %>
      </div>
    </div>
  <% end %>
</div>
