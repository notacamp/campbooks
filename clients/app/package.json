{
  "name": "@campbooks/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -b",
    "record": "node scripts/record.ts",
    "fake-google": "node scripts/fake-provider.ts --provider google",
    "fake-microsoft": "node scripts/fake-provider.ts --provider microsoft",
    "fake-zoho": "node scripts/fake-provider.ts --provider zoho",
    "fake-complete": "node scripts/fake-complete.ts",
    "i18n:check": "node scripts/i18n-check.ts",
    "lint": "eslint . --max-warnings 0 && stylelint --allow-empty-input \"src/**/*.css\" \"stories/**/*.css\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:csp": "vitest run --config vitest.webkit.config.ts",
    "test:fit": "vitest run --config vitest.fit.config.ts",
    "test:tauri": "vitest run --config vitest.tauri.config.ts",
    "test-storybook": "vitest run --config vitest.storybook.config.ts && VITE_STORYBOOK_THEME=dark vitest run --config vitest.storybook.config.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "api:generate": "openapi-typescript ../../openapi/openapi.json --output src/lib/api/schema.gen.ts && openapi-typescript ../../openapi/admin.json --output src/lib/api/admin.gen.ts && node scripts/records-gen.ts",
    "api:check": "pnpm run api:generate && git diff --exit-code -- src/lib/api/schema.gen.ts src/lib/api/admin.gen.ts src/lib/api/records.gen.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@notacamp/ui": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.41",
    "@tauri-apps/api": "2.12.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/y-tiptap": "3.0.10",
    "fractional-indexing": "3.4.0",
    "i18next": "26.5.11",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "web-vitals": "6.2.3",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "10.6.4",
    "@storybook/addon-vitest": "10.6.4",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "storybook": "10.6.4",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
