##[start-action display=Set Trivy environment variables;id=__aquasecurity_trivy-action.__run_3]
##[group]Run # Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.
^[[36;1m# Note: There is currently no way to distinguish between undefined variables and empty strings in GitHub Actions.^[[0m
^[[36;1m# This limitation affects how we handle default values and empty inputs.^[[0m
^[[36;1m# For more information, see: https://github.com/actions/runner/issues/924^[[0m
^[[36;1m^[[0m
^[[36;1m# The following logic implements the configuration priority described in the README:^[[0m
^[[36;1m#^[[0m
^[[36;1m# Inputs^[[0m
^[[36;1m# Environment Variables^[[0m
^[[36;1m# Config File^[[0m
^[[36;1m# Defaults^[[0m
^[[36;1m#^[[0m
^[[36;1m# As noted above defaults are awkward to handle as GitHub Actions will inject those values as the input^[[0m
^[[36;1m# if the caller doesn't provide them, thus if the input matches the default we don't set it as we^[[0m
^[[36;1m# can't tell the difference.  Plus if we did set it when it was the default value then it could potentially^[[0m
^[[36;1m# override an external environment variable, or something in the callers configuration file, which then wouldn't^[[0m
^[[36;1m# match the configuration priority that is documented.^[[0m
^[[36;1mset_env_var_if_provided() {^[[0m
^[[36;1m  local var_name="$1"^[[0m
^[[36;1m  local input_value="$2"^[[0m
^[[36;1m  local default_value="$3"^[[0m
^[[36;1m^[[0m
^[[36;1m  if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then^[[0m
^[[36;1m    # If action was provided with explicit input by the caller set that^[[0m
^[[36;1m    # Use printf %q to safely escape special characters and prevent command injection^[[0m
^[[36;1m    printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt^[[0m
^[[36;1m  fi^[[0m
^[[36;1m}^[[0m
^[[36;1m^[[0m
^[[36;1m# Set environment variables, handling those with default values^[[0m
^[[36;1m# cf. https://aquasecurity.github.io/trivy/latest/docs/configuration/#environment-variables^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_INPUT" "$INPUT_INPUT" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_EXIT_CODE" "$INPUT_EXIT_CODE" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_IGNORE_UNFIXED" "$INPUT_IGNORE_UNFIXED" "false"^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_PKG_TYPES" "$INPUT_VULN_TYPE" "os,library"^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_SEVERITY" "$INPUT_SEVERITY" "UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL"^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_FORMAT" "$INPUT_FORMAT" "table"^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_TEMPLATE" "$INPUT_TEMPLATE" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_OUTPUT" "$INPUT_OUTPUT" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_SKIP_DIRS" "$INPUT_SKIP_DIRS" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_SKIP_FILES" "$INPUT_SKIP_FILES" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_TIMEOUT" "$INPUT_TIMEOUT" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_IGNORE_POLICY" "$INPUT_IGNORE_POLICY" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_QUIET" "$INPUT_HIDE_PROGRESS" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_LIST_ALL_PKGS" "$INPUT_LIST_ALL_PKGS" "false"^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_SCANNERS" "$INPUT_SCANNERS" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_CONFIG" "$INPUT_TRIVY_CONFIG" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_TF_VARS" "$INPUT_TF_VARS" ""^[[0m
^[[36;1mset_env_var_if_provided "TRIVY_DOCKER_HOST" "$INPUT_DOCKER_HOST" ""^[[0m
