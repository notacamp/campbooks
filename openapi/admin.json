  },
  "components": {
    "schemas": {
      "AdminAccount": {
        "type": "object",
        "description": "An identity account, as an administrator sees it.",
        "required": [
          "id",
          "primary_email_verified",
          "created_at",
          "ways_in",
          "passkeys",
          "sessions"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was created."
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its display name."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The account (the `sub` of its tokens)."
          },
          "passkeys": {
            "type": "integer",
            "format": "int64",
            "description": "How many passkeys it has."
          },
          "primary_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The address it was created with."
          },
          "primary_email_verified": {
            "type": "boolean",
            "description": "Whether a provider verified that address."
          },
          "sessions": {
            "$ref": "#/components/schemas/AdminSessions",
            "description": "Its sign-ins."
          },
          "suspended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When an administrator suspended it; absent unless suspended."
          },
          "ways_in": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminWayIn"
            },
            "description": "Its provider ways in, oldest first."
          }
        }
      },
      "AdminConnection": {
        "type": "object",
        "description": "A connection, as an administrator sees it.",
        "required": [
          "id",
          "provider",
          "address",
          "granted_by",
          "capabilities",
          "health",
          "health_changed_at",
          "created_at",
          "streams"
        ],
        "properties": {
          "address": {
            "type": "string",
            "description": "The connected account's address."
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "description": "What it lets Campbooks do."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was connected."
          },
          "granted_by": {
            "$ref": "#/components/schemas/UserId",
            "description": "The member who connected it."
          },
          "health": {
            "$ref": "#/components/schemas/Health",
            "description": "How it is doing."
          },
          "health_changed_at": {
            "type": "string",
            "format": "date-time",
            "description": "Since when it has had this health."
          },
          "health_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why, when it is not `ok` (`grant_revoked`, `rate_limited`, …)."
          },
          "id": {
            "$ref": "#/components/schemas/ConnectionId",
            "description": "The connection."
          },
          "provider": {
            "$ref": "#/components/schemas/Provider",
            "description": "The provider."
          },
          "streams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminStream"
            },
            "description": "Its change streams."
          }
        }
      },
      "AdminConnectionList": {
        "type": "object",
        "description": "A workspace's connections.",
        "required": [
          "connections"
        ],
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminConnection"
            },
            "description": "Oldest first."
          }
        }
      },
      "AdminOverview": {
        "type": "object",
        "description": "The instance at a glance, for administrators.",
        "required": [
          "version",
          "started_at",
          "uptime_seconds",
          "database",
          "configuration",
          "services",
          "ai"
        ],
        "properties": {
          "ai": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiRoleStatus"
            },
            "description": "Each AI role: configured or not, model, provider and whether it\nanswers."
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git commit the build came from, when known."
          },
          "configuration": {
            "$ref": "#/components/schemas/ConfigSummary",
            "description": "The effective configuration: enumerated facts only, no secret."
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus",
            "description": "Whether the database answers, and its migrations."
          },
          "services": {
            "$ref": "#/components/schemas/Facts",
            "description": "Who signs people in, and which providers are set up."
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this server process started."
          },
          "uptime_seconds": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds since then."
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the server.",
            "example": "0.1.0"
          }
        }
      },
      "AdminSessions": {
        "type": "object",
        "description": "The account's sign-ins.",
        "required": [
          "active"
        ],
        "properties": {
          "active": {
            "type": "integer",
            "format": "int64",
            "description": "Browsers signed in to the issuer right now."
          },
          "last_sign_in_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the person last signed in."
          }
        }
      },
      "AdminStream": {
        "type": "object",
        "description": "A stream's sync state, as an administrator sees it.",
        "required": [
          "capability",
          "phase",
          "paused",
          "consecutive_failures"
        ],
        "properties": {
          "capability": {
            "$ref": "#/components/schemas/Capability",
            "description": "The capability it reads."
          },
          "consecutive_failures": {
            "type": "integer",
            "format": "int32",
            "description": "How many runs in a row failed."
          },
          "last_synced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a run last finished."
          },
          "paused": {
            "type": "boolean",
            "description": "Paused until the member connects again."
          },
          "phase": {
            "$ref": "#/components/schemas/Phase",
            "description": "Where it is in its reading."
          }
        }
      },
      "AdminUser": {
        "type": "object",
        "description": "A person, as an administrator sees them.",
        "required": [
          "id",
          "account_id",
          "created_at",
          "workspace_count"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "description": "Their identity account (the `sub` of their tokens), for the identity\nmodule's admin view of the account."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When they first signed in."
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Their name, as their identity provider gives it."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Their email address, as their identity provider gives it."
          },
          "id": {
            "$ref": "#/components/schemas/UserId",
            "description": "The user."
          },
          "workspace_count": {
            "type": "integer",
            "format": "int64",
            "description": "How many workspaces they belong to (not counting deleted ones)."
          }
        }
      },
      "AdminUserDetail": {
        "type": "object",
        "description": "A person and their workspaces.",
        "required": [
          "user",
          "workspaces"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AdminUser",
            "description": "Who they are."
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUserWorkspace"
            },
            "description": "Their workspaces, in the order they joined."
          }
        }
      },
      "AdminUserPage": {
        "type": "object",
