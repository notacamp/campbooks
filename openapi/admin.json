{
  "openapi": "3.1.0",
  "info": {
    "title": "Campbooks admin API",
    "description": "Instance administration. Every operation answers 404 (as for a route that does not exist) unless the caller is a user whose bearer token carries the `admin:access` scope and whose admin profile grants the operation's permission (`x-campbooks-admin.permission`; `super` grants all). Then a token whose last sign-in (`auth_time`) is more than 12 hours old answers 401 `admin_reauth_required`. Every request past the profile check is recorded in the audit trail. These operations are not part of the operation catalogue (`/openapi.json`): automation and the assistant cannot call them. Admin profiles are managed only with the server's CLI (`campbooks-server admin`), never over HTTP. The web app reaches this API through `/bff/admin/*`.",
    "license": {
      "name": "Sustainable Use License",
      "identifier": "LicenseRef-Sustainable-Use"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/admin/v1/connectors/workspaces/{workspace_id}/connections": {
      "get": {
        "tags": [
          "connectors"
        ],
        "summary": "See a workspace's connections and how they sync.",
        "operationId": "connectors.admin_list_connections",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "description": "The workspace.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/WorkspaceId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace's connections (none for an unknown workspace).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminConnectionList"
                }
              }
            }
          },
          "401": {
            "description": "`admin_reauth_required`: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not an administrator with `workspaces.read` (the same answer as an unknown route).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin": [
              "admin:access"
            ]
          }
        ],
        "x-campbooks-admin": {
          "mutates": false,
          "permission": "workspaces.read"
        }
      }
    },
    "/admin/v1/identity/accounts/{account_id}": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "See one account.",
        "operationId": "identity.admin_get_account",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "The account (a token `sub`).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAccount"
                }
              }
            }
          },
          "401": {
            "description": "`admin_reauth_required`: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such account (or another identity provider serves the instance), or not an administrator with `users.read`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin": [
              "admin:access"
            ]
          }
        ],
        "x-campbooks-admin": {
          "mutates": false,
          "permission": "users.read"
        }
      }
    },
    "/admin/v1/identity/accounts/{account_id}/suspend": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Suspend an account.",
        "operationId": "identity.admin_suspend_account",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "The account (a token `sub`).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account, suspended (now or before).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAccount"
                }
              }
            }
          },
          "401": {
            "description": "`admin_reauth_required`: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such account, or not an administrator with `users.suspend`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`account_is_admin`: the account has an admin profile; revoke it with `campbooks-server admin revoke` first.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin": [
              "admin:access"
            ]
          }
        ],
        "x-campbooks-admin": {
          "mutates": true,
          "permission": "users.suspend"
        }
      }
    },
    "/admin/v1/identity/accounts/{account_id}/unsuspend": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Unsuspend an account.",
        "operationId": "identity.admin_unsuspend_account",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "The account (a token `sub`).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The account, not suspended (now or before).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAccount"
                }
              }
            }
          },
          "401": {
            "description": "`admin_reauth_required`: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such account, or not an administrator with `users.suspend`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin": [
              "admin:access"
            ]
          }
        ],
        "x-campbooks-admin": {
          "mutates": true,
          "permission": "users.suspend"
        }
      }
    },
    "/admin/v1/system/overview": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "See the instance's version, health and configuration.",
        "operationId": "system.admin_overview",
        "responses": {
          "200": {
            "description": "The overview.",
