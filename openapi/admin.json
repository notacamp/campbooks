                "schema": {
                  "$ref": "#/components/schemas/AdminOverview"
                }
              }
            }
          },
          "401": {
            "description": "`admin_reauth_required`: sign in again (the last sign-in is more than 12 hours old).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not an administrator with `system.read` (the same answer as an unknown route).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin": [
              "admin:access"
            ]
          }
        ],
        "x-campbooks-admin": {
          "mutates": false,
          "permission": "system.read"
        }
      }
    },
    "/admin/v1/workspaces/users": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "List people.",
        "operationId": "workspaces.admin_list_users",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Only rows whose name or address starts with this (case-insensitive).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "The `next` cursor of the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "How many rows: 1 to 200, default 50.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of people.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserPage"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_query`, `invalid_limit`, `invalid_cursor` or `query_too_long`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "`admin_reauth_required`: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not an administrator with `users.read` (the same answer as an unknown route).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin": [
              "admin:access"
            ]
          }
        ],
        "x-campbooks-admin": {
          "mutates": false,
          "permission": "users.read"
        }
      }
    },
