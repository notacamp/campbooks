          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable reason (`not_found`, `invalid_token`,\n`last_owner`, …); the same in every locale. Match on this, never on\n`title` or `detail`."
          },
          "detail": {
            "type": "string",
            "description": "What went wrong in this occurrence, in the request's locale."
