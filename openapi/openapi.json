{
  "openapi": "3.1.0",
  "info": {
    "title": "Campbooks API",
    "description": "The Campbooks HTTP API. Errors are RFC 9457 `application/problem+json`. Operations require an OAuth 2.1 bearer token with the scope they list (401 without a valid token, 403 without the scope) unless they are public.",
    "license": {
      "name": "Sustainable Use License",
      "identifier": "LicenseRef-Sustainable-Use"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/system/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report instance health.",
        "operationId": "system_health",
        "responses": {
          "200": {
            "description": "The instance and its database are up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/system/version": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report the server version.",
        "operationId": "system_version",
        "responses": {
          "200": {
            "description": "The running build.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/w/{workspace_id}": {
      "get": {
        "tags": [
          "workspaces"
        ],
        "summary": "Read a workspace.",
        "operationId": "workspaces.get",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "description": "The workspace.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/WorkspaceId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceView"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace, or you are not a member.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "workspaces:read"
            ]
          }
        ]
      },
      "delete": {
        "tags": [
          "workspaces"
        ],
        "summary": "Delete a workspace.",
        "operationId": "workspaces.delete",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "description": "The workspace.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/WorkspaceId"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Deleted; its records are purged after the grace period.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceDeletion"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope, or not an owner.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace, or you are not a member.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "workspaces:admin"
            ]
          }
        ]
      },
      "patch": {
        "tags": [
          "workspaces"
        ],
        "summary": "Update a workspace.",
        "operationId": "workspaces.update",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "description": "The workspace.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/WorkspaceId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWorkspace"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid name or body.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope, or not an owner or admin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace, or you are not a member.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "workspaces:admin"
            ]
          }
        ]
      }
    },
    "/api/v1/w/{workspace_id}/invitations": {
