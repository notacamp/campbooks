            "description": "The signup code, when the instance's policy is `code` and this is the\ncaller's first workspace."
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "description": "The instance is healthy.",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "Database status; always `ok` in a 200 response.",
            "example": "ok"
          },
          "status": {
            "type": "string",
            "description": "Overall status; always `ok` in a 200 response.",
            "example": "ok"
          }
        }
      },
      "InvitationId": {
        "type": "string",
        "format": "uuid",
        "description": "InvitationId (UUIDv7)"
      },
      "InvitationList": {
        "type": "object",
        "description": "Pending (not yet accepted) invitations, expired ones included.",
        "required": [
          "invitations"
        ],
        "properties": {
          "invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvitationView"
            },
            "description": "The invitations."
          }
        }
      },
      "InvitationView": {
        "type": "object",
        "description": "A pending invitation, as owners and admins see it. Never carries the\ntoken.",
        "required": [
          "id",
          "email",
          "role",
          "invited_by",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it was sent."
          },
          "email": {
            "type": "string",
            "description": "The invited address.",
            "example": "someone@example.com"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "When it stops working."
          },
          "id": {
            "$ref": "#/components/schemas/InvitationId",
            "description": "Its id."
          },
          "invited_by": {
            "$ref": "#/components/schemas/UserId",
            "description": "Who invited them."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The role they get on accepting."
          }
        }
      },
      "InviteMember": {
        "type": "object",
        "description": "Whom to invite.",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "Their email address; the invitation can only be accepted by a user\nwhose verified email is this one.",
            "example": "someone@example.com"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The role they get: `admin` or `member` (the default). Owners are made\nby promotion, never by invitation."
          }
        },
        "additionalProperties": false
      },
      "Kind": {
        "type": "string",
        "description": "What a workspace is for.",
        "enum": [
          "business",
          "personal"
        ]
      },
      "MemberList": {
        "type": "object",
        "description": "The members, in the order they joined.",
        "required": [
          "members"
        ],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberView"
            },
            "description": "The members."
          }
        }
      },
      "MemberView": {
        "type": "object",
        "description": "A member of a workspace.",
        "required": [
          "user_id",
          "role",
          "joined_at"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Their name, as their identity provider gives it."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Their email address, as their identity provider gives it."
          },
          "joined_at": {
            "type": "string",
            "format": "date-time",
            "description": "When they joined."
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Their role."
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId",
            "description": "The user."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation specific to this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type; `about:blank` when the HTTP status\nsays it all."
          }
        },
        "example": {
          "status": 404,
          "title": "Not Found",
          "type": "about:blank"
        }
      },
      "Role": {
        "type": "string",
