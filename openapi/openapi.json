            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceView"
            },
            "description": "The workspaces."
          }
        }
      },
      "WorkspaceView": {
        "type": "object",
        "description": "A workspace, as its members see it.",
        "required": [
          "id",
          "name",
          "kind",
          "accent",
          "created_at"
        ],
        "properties": {
          "accent": {
            "$ref": "#/components/schemas/Accent",
