      "WorkspaceId": {
        "type": "string",
        "format": "uuid",
        "description": "WorkspaceId (UUIDv7)"
      },
      "WorkspaceList": {
        "type": "object",
        "description": "The caller's workspaces, oldest first, each with their role.",
        "required": [
