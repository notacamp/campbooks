        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecurityEventView"
            },
            "description": "The events, newest first."
          }
        }
      },
      "SecurityEventView": {
        "type": "object",
        "description": "One entry of the security log.",
        "required": [
          "id",
          "kind",
          "at",
          "metadata"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When."
          },
          "id": {
            "$ref": "#/components/schemas/SecurityEventId",
            "description": "Its id."
          },
          "kind": {
            "type": "string",
            "description": "What happened: `workspace_created`, `role_changed`, `invitation_created`,\n`invitation_accepted`, `member_removed`, `member_left`, `workspace_deleted`.",
            "example": "role_changed"
          },
          "metadata": {
            "description": "Ids and roles involved; never secrets."
          },
          "user_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserId",
                "description": "Who did it."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "UpdateWorkspace": {
        "type": "object",
        "description": "The settings to change; absent fields stay as they are.",
        "properties": {
          "accent": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Accent",
                "description": "A new colour."
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "A new name, 1 to 100 characters (trimmed)."
          }
        },
        "additionalProperties": false
      },
      "UserId": {
        "type": "string",
        "format": "uuid",
        "description": "UserId (UUIDv7)"
      },
      "VersionResponse": {
        "type": "object",
        "description": "The running build.",
        "required": [
          "version"
