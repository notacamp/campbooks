    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An OAuth 2.1 access token (a JWT) issued by this instance's identity provider, the issuer configured as `CAMPBOOKS_AUTH__ISSUER`. Each operation lists the scope it requires; operations with an empty requirement are public. Scopes:\n\n- `system:read`: Read operational status.\n- `workspaces:admin`: Manage workspaces you own or administer: settings, members, invitations, deletion and the security log.\n- `workspaces:read`: See your workspaces and who belongs to them.\n- `workspaces:write`: Create workspaces, accept invitations and leave workspaces."
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Instance health and version."
    },
    {
      "name": "workspaces",
      "description": "Workspaces, members and roles, invitations and the security log. Workspace-owned resources live under `/api/v1/w/{workspace_id}/`; a caller who is not a member (or a client token bound to another workspace) gets 404."
    }
  ]
}
