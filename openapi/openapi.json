{
  "openapi": "3.1.0",
  "info": {
    "title": "Campbooks API",
    "description": "The Campbooks HTTP API. Errors are RFC 9457 `application/problem+json`. Operations require an OAuth 2.1 bearer token with the scope they list (401 without a valid token, 403 without the scope) unless they are public.",
    "license": {
      "name": "Sustainable Use License",
      "identifier": "LicenseRef-Sustainable-Use"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/actions/system.whoami": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Who the API takes the caller to be: the subject, client, scopes and workspace of the access token the request carries.",
        "operationId": "system_whoami",
        "requestBody": {
          "description": "The action's input.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhoamiInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The action ran.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "result"
                  ],
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/WhoamiOutput"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The body is not JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token lacks the action's scope.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The body is over 1 MiB.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "The body is not `application/json`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The body does not match the action's input.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "system:read"
            ]
          }
        ]
      }
    },
    "/api/v1/system/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report instance health.",
        "operationId": "system_health",
        "responses": {
          "200": {
            "description": "The instance and its database are up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/v1/system/version": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report the server version.",
        "operationId": "system_version",
        "responses": {
          "200": {
            "description": "The running build.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CallerKind": {
        "type": "string",
        "description": "Who a token was issued to.",
        "enum": [
          "user",
          "client"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "description": "The instance is healthy.",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "Database status; always `ok` in a 200 response.",
            "example": "ok"
          },
          "status": {
            "type": "string",
            "description": "Overall status; always `ok` in a 200 response.",
            "example": "ok"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation specific to this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem type."
          },
          "type": {
            "type": "string",
            "description": "URI identifying the problem type; `about:blank` when the HTTP status\nsays it all."
          }
        },
        "example": {
          "status": 404,
          "title": "Not Found",
          "type": "about:blank"
        }
      },
      "VersionResponse": {
        "type": "object",
        "description": "The running build.",
        "required": [
          "version"
        ],
        "properties": {
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git commit the build came from, when known (`GIT_SHA` at runtime).",
            "example": "3f2c1e0"
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the server.",
            "example": "0.1.0"
          }
        }
      },
      "WhoamiInput": {
        "type": "object",
        "description": "No input."
      },
      "WhoamiOutput": {
        "type": "object",
        "description": "The caller, as the access token describes it.",
        "required": [
          "subject",
          "kind",
          "scopes"
        ],
        "properties": {
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The client the token was issued to, when it names one.",
            "example": "campbooks-web"
          },
          "kind": {
            "$ref": "#/components/schemas/CallerKind",
            "description": "A person signed in through a client, or a client on its own behalf."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The scopes the token grants, sorted.",
            "example": [
              "openid",
              "system:read"
            ]
          },
          "subject": {
            "type": "string",
            "description": "The token's subject (or, for a client acting on its own behalf, its\nclient id).",
            "example": "8d6f0d5e-2c55-4f7e-9a8e-1b8c1f3f2a10"
          },
          "workspace": {
            "type": [
              "string",
              "null"
            ],
            "description": "The workspace a client is bound to; none for people."
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An OAuth 2.1 access token (a JWT) issued by this instance's identity provider, the issuer configured as `CAMPBOOKS_AUTH__ISSUER`. Each operation lists the scope it requires; operations with an empty requirement are public. Scopes:\n\n- `system:read`: Read operational status."
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Instance health and version."
    }
  ]
}
