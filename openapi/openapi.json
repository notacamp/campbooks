    "/api/v1/w/{workspace_id}/members/{user_id}": {
      "delete": {
        "tags": [
          "workspaces"
        ],
        "summary": "Remove a member.",
        "operationId": "workspaces.remove_member",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "description": "The workspace.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/WorkspaceId"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "description": "The member.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/UserId"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed."
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope, not an owner or admin, or an admin removing an owner.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such workspace or member.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`last_owner`: the workspace would have no owner.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "workspaces:admin"
            ]
          }
        ]
      },
