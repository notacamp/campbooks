    "/api/v1/workspaces/invitations/accept": {
      "post": {
        "tags": [
          "workspaces"
        ],
        "summary": "Accept an invitation.",
        "operationId": "workspaces.accept_invitation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "You are a member; the workspace with your role.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No valid access token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope, a client token, or `invitation_email_mismatch`: your verified email is not the invited one.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such invitation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`invitation_used`, `invitation_expired` or `already_a_member`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": [
              "workspaces:write"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Accent": {
        "type": "string",
        "description": "The workspace's colour, one of the design system's accent presets.",
        "enum": [
          "business",
          "personal",
          "forest"
        ]
      },
      "AcceptInvitation": {
        "type": "object",
        "description": "The invitation to accept.",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The token from the invitation link."
          }
        },
        "additionalProperties": false
      },
      "ChangeRole": {
        "type": "object",
        "description": "The new role.",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "The member's new role."
          }
        },
        "additionalProperties": false
      },
      "CreateWorkspace": {
        "type": "object",
        "description": "A new workspace.",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "accent": {
            "oneOf": [
