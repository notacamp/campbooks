            "description": "When it was created."
          },
          "id": {
            "$ref": "#/components/schemas/WorkspaceId",
            "description": "Its id."
          },
          "kind": {
            "$ref": "#/components/schemas/Kind",
            "description": "What it is for."
          },
          "name": {
