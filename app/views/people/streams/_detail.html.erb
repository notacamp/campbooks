<%# The right pane: one stream's threads, or the placeholder when none is open. %>
<% if @stream_name.blank? %>
  <div class="hidden flex-1 items-center justify-center p-10 lg:flex">
    <div class="max-w-xs text-center">
      <div class="mx-auto mb-4 w-fit"><%= render Campbooks::ScoutAvatar.new(size: :xl) %></div>
      <p class="text-[15px] font-semibold text-foreground"><%= t("people.streams.placeholder_title") %></p>
      <p class="mt-1.5 text-sm text-muted-foreground"><%= t("people.streams.placeholder_body") %></p>
    </div>
  </div>
<% else %>
  <div class="flex h-full w-full min-w-0 flex-col">
    <div class="flex items-center px-3 py-2 lg:hidden">
      <button type="button" data-action="click->email-mobile#showList"
              class="inline-flex min-h-[40px] items-center gap-1 -ml-1.5 rounded-md px-1.5 text-sm font-medium text-accent-600 hover:bg-accent-50">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        <%= t("people.conversation.back") %>
      </button>
    </div>

    <div class="flex flex-wrap items-center gap-3 border-b border-border px-5 py-4 sm:px-7">
      <%= render Campbooks::People::StreamIcon.new(kind: @stream_icon) %>
      <div class="min-w-0">
        <div class="truncate text-[16px] font-semibold text-foreground"><%= @stream_title %></div>
        <div class="text-xs text-muted-foreground"><%= t("people.streams.threads_meta", count: @stream_total) %></div>
      </div>
      <span class="flex-1"></span>
      <% unless @organization %>
        <%= button_to tag_group_archive_all_path, params: { group: @stream_name }, method: :post,
              form: { data: { turbo: false }, class: "inline-flex" },
              data: { turbo_confirm: t("people.streams.archive_all_confirm") },
              class: "inline-flex h-[30px] flex-shrink-0 items-center rounded-lg border border-border bg-transparent px-3 text-[12.5px] font-medium text-foreground hover:bg-secondary" do %>
          <%= t("people.streams.archive_all") %>
        <% end %>
        <%= link_to t("people.streams.open_classic"), email_messages_path(group: @stream_name, show_list: 1),
              data: { turbo_frame: "_top" },
              class: "inline-flex h-[30px] flex-shrink-0 items-center rounded-lg border border-border px-3 text-[12.5px] font-medium text-foreground no-underline hover:bg-secondary" %>
      <% end %>
    </div>

    <div class="flex-1 overflow-y-auto">
      <% if @stream_threads.blank? %>
        <p class="py-16 text-center text-sm text-muted-foreground"><%= t("people.streams.no_threads") %></p>
      <% else %>
        <div id="stream_thread_list" class="divide-y divide-border">
          <%= render partial: "people/streams/thread_row", collection: @stream_threads, as: :thread %>
        </div>
        <% if @stream_pagy&.next %>
          <%= render "people/streams/thread_pagination", pagy: @stream_pagy %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
