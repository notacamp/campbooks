<%# One person's email threads newest-first: each thread opens on its newest message
    with older ones folded beneath (newest-first), and every open message carries
    its own Reply, Reply all and Forward. Scout's standing and action chips pinned above.
    The Details rail (aside#people_details_pane) sits to the right at xl+. %>
<div class="relative flex h-full w-full min-w-0"
     data-controller="people-details"
     data-people-details-person-id-value="<%= @person.id %>"
     data-people-details-open-value="<%= params[:details].present? %>">
  <%# Main conversation column — narrows at xl to make room for the rail. %>
  <div class="flex h-full min-w-0 flex-1 flex-col">
  <%# Mobile: back to the list. %>
  <div class="flex items-center px-3 py-2 lg:hidden">
    <button type="button" data-action="click->email-mobile#showList"
            class="inline-flex min-h-[40px] items-center gap-1 -ml-1.5 rounded-md px-1.5 text-sm font-medium text-accent-600 hover:bg-accent-50">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <%= t("people.conversation.back") %>
    </button>
  </div>

  <%# Header: avatar, name, meta, sender tags, optional Reply button, kebab. %>
  <div class="flex items-center gap-3 border-b border-border px-5 py-4 sm:px-7">
    <%= render Campbooks::ContactAvatar.new(email: (@primary_contact&.email || @person.display_name).to_s, size: :lg, variant: :neutral) %>
    <div class="min-w-0">
      <div class="truncate text-[17px] font-semibold text-foreground"><%= @person.display_name %></div>
      <div class="truncate text-xs text-muted-foreground"><%= people_conversation_meta(@person, @primary_contact, @email_total, @first_seen) %></div>
    </div>
    <span class="flex-1"></span>
    <% @sender_tags.each do |tag| %>
      <span class="hidden flex-shrink-0 rounded-md px-1.5 py-0.5 text-[11px] font-medium sm:inline-flex"
            style="color: <%= tag.color %>; background-color: <%= tag.color %>1f;"><%= tag.name %></span>
    <% end %>
    <% if @can_send && @reply_target %>
      <%= render "people/compose_button", message: @reply_target, mode: :reply,
            label: t("people.conversation.reply"), variant: :ghost %>
    <% end %>
    <%# Done / Snooze / Star header actions (only when the person has a standing row). %>
    <% if (row = PeopleStanding.for_user(current_user).find_by(counterpart: @person)) %>
      <% if row.feed_item_id && row.needs_you %>
        <%= button_to people_action_path(@person.id, :done),
              class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors",
              title: t("people.actions.done", name: @person.display_name.split.first),
              data: { turbo_stream: true } do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        <% end %>
      <% end %>
      <% if row.email_message_id %>
        <%= button_to people_action_path(@person.id, :snooze),
              params: { until: "tomorrow" },
              class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border text-muted-foreground hover:bg-secondary hover:text-foreground transition-colors",
              title: t("people.actions.snooze_title"),
              data: { turbo_stream: true } do %>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <% end %>
      <% end %>
      <% star_action = (row.data || {})["starred"] ? :unstar : :star %>
      <%= button_to people_action_path(@person.id, star_action),
            class: "inline-flex h-8 w-8 items-center justify-center rounded-lg border border-border transition-colors #{ (row.data || {})["starred"] ? "text-amber-500 hover:text-amber-600" : "text-muted-foreground hover:bg-secondary hover:text-foreground" }",
            title: (row.data || {})["starred"] ? t("people.conversation.unstar") : t("people.conversation.star"),
            data: { turbo_stream: true } do %>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
        </svg>
      <% end %>
    <% end %>
    <%# Details ⓘ button — visible below xl only; toggles the sheet. %>
    <button type="button"
            class="xl:hidden inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground hover:bg-secondary"
            title="<%= t("people.details.title") %>"
            data-action="click->people-details#toggle"
            data-people-details-target="detailsBtn">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </button>
    <%= render "people/conversation_menu" %>
  </div>

  <%# Scrollable threads column — newest at the top. Positioned so absolutely
      placed descendants (the sentinel spinner's sr-only label) scroll with it
      instead of anchoring to the page. %>
  <div class="relative flex-1 overflow-y-auto">
    <div class="w-full px-6 pb-6 pt-5">

      <%# Scout's standing pinned above the threads. %>
      <%= render Campbooks::ScoutNote.new(message: @standing.text.presence || people_standing_note(@standing, @person) || t("people.conversation.no_standing"),
            time: t("people.conversation.where_things_stand"), class: "mb-3") %>

      <% if @can_send && @reply_target %>
        <div class="mb-3">
          <%= render Campbooks::EmailScoutActions.new(message: @reply_target, surface: :detail,
                can_send: @can_send, show_note: false) %>
        </div>
      <% end %>

      <%# Slot for Scout's draft-questions form (EmailToolsController streams into here). %>
      <div id="thread_compose_target"></div>

      <%# Thread blocks, newest-first. %>
      <div id="people_conversation">
        <% @conversation_threads.each_with_index do |ct, i| %>
          <% is_newest = (i == 0 && @conversation_pagy&.page == 1) %>
          <%= render Campbooks::People::ThreadBlock.new(
                conversation_thread: ct,
                person_first_name: people_first_name(@person),
                person_id: @person.id,
                newest_thread: is_newest,
                can_send: @sendable_account_ids.include?(ct.thread.email_account_id),
                scout_draft: (is_newest ? @scout_draft : nil)) %>
        <% end %>
      </div>

      <% if @conversation_threads.blank? %>
        <p class="py-10 text-center text-sm text-muted-foreground"><%= t("people.conversation.empty") %></p>
      <% end %>

      <%= render "people/conversation_older" if @conversation_pagy&.next %>
    </div>
  </div>
  </div><%# /main conversation column %>

  <%# Details rail / sheet. Static at xl+; sheet (translate-x-full → translate-x-0) below xl. %>
  <aside id="people_details_pane"
         class="absolute inset-y-0 right-0 z-20 w-full lg:w-[400px] xl:w-[300px] translate-x-full
                border-l border-border bg-card transition-transform duration-200
                xl:static xl:translate-x-0 xl:flex-none"
         data-people-details-target="pane">
    <%= turbo_frame_tag "people_details",
          src: people_details_path(@person),
          loading: :lazy do %>
      <%# Loading placeholder %>
      <div class="flex h-full items-center justify-center">
        <%= render Campbooks::Spinner.new %>
      </div>
    <% end %>
  </aside>
</div>
