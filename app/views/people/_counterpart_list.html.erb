<%# The counterpart list: Need-you first (by urgency), then Recent (by last
    activity, paginated with an infinite-scroll sentinel). Rendered inside the
    "people_results" frame so search swaps the whole list; the sentinel streams the
    next Recent page into #people_recent_list. %>
<% if @need_you.blank? && @recent.blank? %>
  <div class="px-6 py-10 text-center">
    <p class="text-sm text-muted-foreground">
      <%= @query.present? ? t("people.index.no_matches") : t("people.index.empty") %>
    </p>
    <% if @query.blank? %>
      <p class="mt-1.5 text-xs text-muted-foreground"><%= t("people.index.empty_hint") %></p>
    <% end %>
  </div>
<% else %>
  <% if @need_you.any? %>
    <div class="flex items-center gap-1.5 px-4 pb-1.5 pt-3.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">
      <%= t("people.index.need_you") %>
    </div>
    <div class="space-y-0.5 px-1.5 pb-1">
      <%= render partial: "people/counterpart_row", collection: @need_you, as: :counterpart %>
    </div>
  <% end %>

  <% if @recent.any? %>
    <div class="flex items-center gap-1.5 px-4 pb-1.5 pt-3.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted-foreground">
      <%= t("people.index.recent") %>
    </div>
    <div id="people_recent_list" class="space-y-0.5 px-1.5 pb-2">
      <%= render partial: "people/counterpart_row", collection: @recent, as: :counterpart %>
    </div>
    <% if @recent_pagy&.next %>
      <%= render "people/recent_pagination", pagy: @recent_pagy, query: @query %>
    <% end %>
  <% end %>
<% end %>
