<%# Older threads page: append ThreadBlocks into the list, then update or remove
    the lazy sentinel. Never newest_thread: true on subsequent pages. %>
<%= turbo_stream.append "people_conversation" do %>
  <% @conversation_threads.each do |ct| %>
    <%= render Campbooks::People::ThreadBlock.new(
          conversation_thread: ct,
          person_first_name: people_first_name(@person),
          person_id: @person.id,
          newest_thread: false,
          can_send: @sendable_account_ids.include?(ct.thread.email_account_id),
          scout_draft: nil) %>
  <% end %>
<% end %>

<% if @conversation_pagy&.next %>
  <%= turbo_stream.replace "people_conversation_older" do %>
    <%= render "people/conversation_older" %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "people_conversation_older" %>
<% end %>
