<%# Next page of the Recent list: append the rows, then advance (or retire) the
    lazy sentinel. Mirrors organizations/index.turbo_stream. %>
<%= turbo_stream.append "people_recent_list" do %>
  <%= render partial: "people/counterpart_row", collection: @recent, as: :counterpart %>
<% end %>

<% if @recent_pagy&.next %>
  <%= turbo_stream.replace "people_recent_pagination" do %>
    <%= render "people/recent_pagination", pagy: @recent_pagy, query: @query %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "people_recent_pagination" %>
<% end %>
