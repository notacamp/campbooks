<%# Broadcasted by Emails::InboxBroadcaster#upsert on the filter-safe "inbox_#{user.id}"
    stream so folder/group/search views get a visible refresh hint without receiving
    an injected row. The default inbox renders no placeholder, so this replace is a
    silent no-op there (Turbo ignores missing targets). Must keep id="new_mail_pill"
    so repeated broadcasts replace it in place (idempotent). %>
<div id="new_mail_pill" class="relative z-10 pointer-events-none">
  <div class="flex justify-center px-3 pt-1.5 pb-0.5">
    <button type="button"
            data-action="click->inbox-live#refresh"
            class="pointer-events-auto inline-flex items-center gap-1.5 rounded-full
                   bg-accent-600 hover:bg-accent-700 active:bg-accent-800
                   px-3 py-1 text-[11px] font-semibold text-white
                   shadow-md shadow-accent-900/20 transition-colors
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-1
                   dark:bg-accent-500 dark:hover:bg-accent-400 dark:active:bg-accent-300">
      <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
      <span><%= t(".label") %></span>
      <span class="opacity-70"><%= t(".refresh") %></span>
    </button>
  </div>
</div>
