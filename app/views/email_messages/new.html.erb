<%# The Desk — writing gets the whole screen. Compose from intent: one input +
    inferred chips + a bordered editor card, Scout's chat panel tucked behind
    a quiet "Show conversation" link. %>
<%= turbo_frame_tag "email_detail", class: "block h-full" do %>
    <div class="flex h-full flex-col bg-card" data-controller="compose-chat">
      <% if @account %>
        <div class="flex-1 overflow-y-auto">
          <%= render(Campbooks::Compose::Engine.new(
                shell: :desk, desk: true,
                mode: @mode,
                action_url: @reply_source ? send_message_email_message_path(@reply_source) : send_new_email_messages_path,
                message: @reply_source,
                draft: @draft,
                to: @to, cc: @cc, bcc: @bcc,
                subject: @subject, body: @body, quoted_body: @quoted_body,
                signatures: @signatures,
                signature_id: @signature_id,
                accounts: @reply_source ? [] : @sendable_accounts.to_a,
                attachment_entries: @attachment_entries,
                form_id: "compose_desk_form",
                intent: @intent,
                heading: t(".heading_#{@mode}"),
                back_url: email_messages_path,
                to_inferred: @to_inferred,
                subject_inferred: @subject_inferred
              )) %>

          <%# The intent input posts to this Scout thread; its auto-actions fill
              the editor + envelope above. Hidden by default — a quiet link opens
              it for people who want the conversation. %>
          <div class="mx-auto w-full max-w-[680px] px-4 pb-16 sm:px-6">
            <button type="button" data-action="click->compose-chat#toggleConversation"
                    class="text-[12.5px] text-muted-foreground underline-offset-2 transition-colors hover:text-foreground hover:underline">
              <%= t(".show_conversation") %>
            </button>
            <div data-compose-chat-target="conversation" class="mt-3 hidden overflow-hidden rounded-2xl border border-border">
              <div class="flex items-center gap-1.5 border-b border-border px-4 py-2.5">
                <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" style="color: var(--ember-solid)" aria-hidden="true">
                  <path d="M12 2l1.7 5.6L19.5 9l-5.8 1.4L12 16l-1.7-5.6L4.5 9l5.8-1.4z"/>
                </svg>
                <span class="text-[12px] font-semibold text-foreground"><%= t(".scout_label") %></span>
              </div>
              <%= turbo_stream_from "compose_chat_#{current_user.id}" %>
              <div data-chat-panel-target="body" class="flex max-h-[420px] flex-col">
                <div id="compose_messages_wrapper" class="flex flex-col">
                  <%= render "email_compose_chat/messages_panel", thread: @compose_thread, messages: @compose_messages %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <div class="flex flex-1 items-center justify-center">
          <%= render(Campbooks::EmptyState.new(variant: :card, title: t(".no_sendable_accounts_title"), description: t(".no_sendable_accounts_description"))) %>
        </div>
      <% end %>
      <div id="redirect_script"></div>
    </div>
<% end %>
