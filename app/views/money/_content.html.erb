<div id="money_content" class="mt-4">
  <%= render Campbooks::Money::Read.new(read: page.read, class: "mt-1 max-w-[900px]") %>
  <%= render Campbooks::Money::Strip.new(read: page.read, class: "mt-5") %>
  <% if page.needs_you.any? %>
    <%= render Campbooks::Money::NeedsYou.new(
      items: page.needs_you,
      overflow: page.needs_you_overflow,
      statement: page.selected_statement,
      id: "money_needs",
      class: "mt-8"
    ) %>
  <% end %>
  <%# loan slot: the loan PR renders its card here %>
  <%= render Campbooks::Money::Statements.new(page: page, class: "mt-8") %>
  <%= render Campbooks::Money::Unbanked.new(
    obligations: page.missing,
    evidence: page.evidence,
    id: "money_unbanked",
    class: "mt-8"
  ) %>
</div>
