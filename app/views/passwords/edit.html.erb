<% content_for :main_class, auth_canvas_class %>

<%= render(Campbooks::AuthCard.new(title: t(".heading"), subtitle: t(".tagline"))) do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-9 space-y-5 animate-stage-in", html: { style: "--stage-delay: .16s" } do |form| %>
    <%= render(Campbooks::Input.new(:password, type: :password, label: t(".password_label"), placeholder: t(".password_placeholder"), required: true, autofocus: true, autocomplete: "new-password")) %>

    <%= render(Campbooks::Input.new(:password_confirmation, type: :password, label: t(".password_confirmation_label"), placeholder: t(".password_confirmation_placeholder"), required: true, autocomplete: "new-password")) %>

    <div class="pt-1">
      <%= render(Campbooks::Button.new(variant: :primary, type: "submit", size: :lg, class: "w-full justify-center")) { t(".submit") } %>
    </div>
  <% end %>
<% end %>
