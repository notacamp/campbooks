<% content_for :main_class, auth_canvas_class %>

<%= render(Campbooks::AuthCard.new(title: t(".heading"), subtitle: t(".tagline"))) do %>
  <%= form_with url: passwords_path, class: "mt-9 space-y-5 animate-stage-in", html: { style: "--stage-delay: .16s" } do |form| %>
    <%= render(Campbooks::Input.new(:email_address, type: :email, label: t(".email_label"), placeholder: t(".email_placeholder"), required: true, autofocus: true, autocomplete: "email", value: params[:email_address])) %>

    <div class="pt-1">
      <%= render(Campbooks::Button.new(variant: :primary, type: "submit", size: :lg, class: "w-full justify-center")) { t(".submit") } %>
    </div>
  <% end %>

  <p class="mt-6 text-center text-sm animate-stage-in" style="--stage-delay: .2s">
    <%= link_to t(".back_to_sign_in"), new_session_path, class: "font-medium text-muted-foreground hover:text-foreground" %>
  </p>
<% end %>
