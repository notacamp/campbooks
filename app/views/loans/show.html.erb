<%# Loan detail page: all instalments in a table, the terms, and edit actions. %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-6">
  <%# Page header with back link %>
  <div class="flex items-center gap-3 mb-6">
    <%= link_to money_path, class: "inline-flex items-center gap-1.5 text-[13px] text-muted-foreground hover:text-foreground transition-colors" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <%= t(".back") %>
    <% end %>
  </div>

  <div class="flex items-start justify-between gap-4 flex-wrap mb-1">
    <div>
      <h1 class="text-[22px] font-semibold tracking-tight"><%= @loan.lender %></h1>
      <p class="text-[13px] text-muted-foreground mt-0.5">
        <%= @loan.principal_cents > 0 ? number_to_currency(@loan.principal_cents / 100.0, unit: "€", precision: 0) : "" %>
        over <%= @loan.term_months %> months ·
        <%= number_to_currency(@loan.instalment_cents / 100.0, unit: "€", precision: 2) %> on the <%= @loan.first_instalment_on&.day.ordinalize %>
        <% if @loan.rate_note.present? %>
          · <%= @loan.rate_note %>
        <% end %>
      </p>
    </div>

    <%= link_to t(".edit_terms"), "#",
          class: "inline-flex items-center px-3 py-1.5 rounded-lg border border-border text-[12.5px] font-medium text-muted-foreground hover:bg-muted/40 transition-colors",
          data: { action: "click->loan-form#openEdit" } %>
  </div>

  <%# Loan stats %>
  <div class="flex flex-wrap gap-6 mt-4 mb-6 py-4 border-y border-border/50">
    <div>
      <div class="text-[11px] font-bold tracking-widest uppercase text-muted-foreground"><%= t(".paid_label") %></div>
      <div class="text-[16px] font-semibold tabular-nums mt-0.5"><%= @loan.paid_count %> <%= t(".of") %> <%= @loan.term_months %></div>
    </div>
    <div>
      <div class="text-[11px] font-bold tracking-widest uppercase text-muted-foreground"><%= t(".to_go_label") %></div>
      <div class="text-[16px] font-semibold tabular-nums mt-0.5">
        <%= number_to_currency(@loan.remaining_cents / 100.0, unit: "€", precision: 0) %>
      </div>
    </div>
    <% if (nxt = @loan.next_expected) %>
      <div>
        <div class="text-[11px] font-bold tracking-widest uppercase text-muted-foreground"><%= t(".next_label") %></div>
        <div class="text-[16px] font-semibold mt-0.5"><%= l(nxt.expected_on, format: :date) %></div>
      </div>
    <% end %>
  </div>

  <%# Instalment table %>
  <h2 class="text-[12px] font-bold tracking-widest uppercase text-muted-foreground mb-3"><%= t(".all_instalments") %></h2>

  <div class="space-y-0 divide-y divide-border/40">
    <% @instalments.each do |ins| %>
      <div class="grid grid-cols-[40px_1fr_1fr_auto] gap-3 py-3 items-center text-[13px]">
        <span class="text-muted-foreground text-[12px] tabular-nums">#<%= ins.number %></span>
        <span class="text-muted-foreground text-[12px]"><%= l(ins.expected_on, format: :date) %></span>
        <span class="tabular-nums font-medium"><%= number_to_currency(ins.amount_cents / 100.0, unit: "€", precision: 2) %></span>
        <%= status_chip(ins) %>
      </div>
    <% end %>
  </div>
</div>
